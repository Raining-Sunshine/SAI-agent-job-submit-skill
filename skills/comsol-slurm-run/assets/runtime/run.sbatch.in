#!/bin/bash
# Organization billing and storage; one shared-memory COMSOL process per node.
#SBATCH --job-name=__JOBNAME__
#SBATCH --account=__ACCOUNT__
#SBATCH --partition=__PARTITION__
#SBATCH --qos=__QOS__
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=__CPUS__
#SBATCH --mem=__MEM__G
#SBATCH --time=__WALLTIME__
#SBATCH --chdir="__RUNDIR__"
#SBATCH --output="__RUNDIR__/slurm-%j.out"
#SBATCH --error="__RUNDIR__/slurm-%j.err"

set -uo pipefail
export PYTHONDONTWRITEBYTECODE=1
RUNDIR="__RUNDIR__"
COMSOL="__COMSOL__"
cd "$RUNDIR" || exit 1
date +%s > job_start_epoch
COMSOL_TMP=$(mktemp -d "/tmp/comsol-${SLURM_JOB_ID}-XXXXXX") || exit 1
export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"
mkdir -p recovery
printf 'Job=%s Node=%s Start=%s\n' "$SLURM_JOB_ID" "$(hostname)" "$(date -Is)"
echo starting > phase.txt
python3 -u monitor.py > monitor.log 2>&1 &
MONITOR_PID=$!
cleanup() {
 rc=$?
 trap - EXIT
 test -f exit_code || printf '%s\n' "$rc" > exit_code
 date +%s > job_end_epoch
 touch monitor.stop
 wait "$MONITOR_PID" || true
 sstat --allsteps -j "$SLURM_JOB_ID" --format=JobID,AveCPU,AveRSS,MaxRSS -P > slurm_resources.txt 2>&1 || true
 # Retain original observations before removing regenerable intermediates.
 if python3 finalize_report.py; then
  python3 clean_intermediates.py --inside-job || true
 else
  echo 'Finalization failed; retain intermediates until records are recovered.' >&2
 fi
 if [[ "$COMSOL_TMP" == /tmp/comsol-"${SLURM_JOB_ID}"-* ]]; then
  rm -rf -- "$COMSOL_TMP"
 fi
 printf 'End=%s\n' "$(date -Is)"
 exit "$rc"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Query the saved mesh without remeshing, solving, or modifying security settings.
echo mesh_metadata > phase.txt
"$COMSOL" compile InspectModel.java > metadata_compile.log 2>&1
compile_rc=$?
if [ "$compile_rc" -eq 0 ]; then
 srun --cpu-bind=cores "$COMSOL" -np 1 -tmpdir "$COMSOL_TMP" batch -inputfile "$RUNDIR/InspectModel.class" -nosave -batchlog "$RUNDIR/metadata_batch.log"
 printf '%s\n' "$?" > metadata_exit_code
 python3 extract_mesh_stats.py || true
else
 printf '%s\n' "$compile_rc" > metadata_exit_code
fi

# Fail explicitly if CPU/memory recording did not start.
if ! kill -0 "$MONITOR_PID" 2>/dev/null || ! test -s resource_usage.txt; then
 echo 'Resource monitor unavailable; inspect monitor.log.' >&2
 exit 3
fi
echo solving___STUDY__ > phase.txt
date +%s > solve_start_epoch
srun --cpu-bind=cores "$COMSOL" -np "$SLURM_CPUS_PER_TASK" -tmpdir "$COMSOL_TMP" -recoverydir "$RUNDIR/recovery" batch -inputfile "$RUNDIR/__INPUT__" -outputfile "$RUNDIR/__OUTPUT__" -study __STUDY__ -batchlog "$RUNDIR/batch.log"
native_rc=$?
date +%s > solve_end_epoch
printf '%s\n' "$native_rc" > comsol_exit_code
rc=$native_rc
# Native exit code alone is insufficient to establish solver success.
if python3 -c 'from pathlib import Path; import sys; p=Path("batch.log"); s=p.read_text(errors="replace") if p.exists() else ""; sys.exit(0 if "/*****Error********/" in s or "Returned solution is not converged." in s else 1)'; then
 rc=2
fi
printf '%s\n' "$rc" > exit_code
echo finished > phase.txt
exit "$rc"
