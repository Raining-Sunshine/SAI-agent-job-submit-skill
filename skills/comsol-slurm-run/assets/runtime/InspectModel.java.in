import com.comsol.model.*;
import com.comsol.model.util.*;
import java.io.*;
public class InspectModel {
 public static Model run() throws Exception {
  Model m=ModelUtil.load("Inspect", __JAVA_MODEL_PATH__);
  try(PrintWriter w=new PrintWriter(System.out,true)) {
   w.println("MESH_STATISTICS_BEGIN");
   w.println("Source: COMSOL Java API; saved input mesh, no remeshing.");
   for(String c:m.component().tags()) for(String tag:m.component(c).mesh().tags()) {
    w.println("Component="+c+" Mesh="+tag);
    w.println("Vertex count="+m.component(c).mesh(tag).getNumVertex());
    w.println("COMSOL getNumElem() count="+m.component(c).mesh(tag).getNumElem());
    long vol=0;
    for(String t:m.component(c).mesh(tag).getTypes()){
     int n=m.component(c).mesh(tag).getNumElem(t);
     w.println("Element type "+t+"="+n);
     if(t.equals("tet")||t.equals("hex")||t.equals("prism")||t.equals("pyr")) vol+=n;
    }
    w.println("3D volume element count="+vol);
    w.flush();
   }
   w.println("MESH_STATISTICS_END");
  }
  return m;
 }
 public static void main(String[] args) throws Exception {run();}
}
